<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/habit_surface"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/habit_primary"
        android:padding="12dp"
        android:text="@string/challenge_widget_preview_habit"
        android:textColor="@color/habit_field"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:text="@string/challenge_widget_preview_versus"
        android:textColor="@color/habit_on_surface"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_trophy"
        android:drawablePadding="6dp"
        android:drawableTint="@color/habit_primary"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:text="@string/challenge_widget_preview_leader"
        android:textColor="@color/habit_on_surface"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp"
        android:text="@string/challenge_widget_preview_progress"
        android:textColor="@color/habit_on_surface"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp"
        android:text="@string/challenge_widget_preview_days_left"
        android:textColor="@color/habit_on_surface"
        android:textSize="12sp" />
</LinearLayout>
